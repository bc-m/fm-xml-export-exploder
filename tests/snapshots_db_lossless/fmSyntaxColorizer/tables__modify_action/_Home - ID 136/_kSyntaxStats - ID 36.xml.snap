		<Field>
			<FieldReference id="36" name="_kSyntaxStats" repetition="1" UUID="9200DA59-F839-46AC-88A3-478B3858935B">
				<Calculation>
					<TableOccurrenceReference id="1065123" name="_Home" UUID="DED63781-79A4-481F-93A7-15FB9149DCD6"></TableOccurrenceReference>
					<Text><![CDATA[SetzeVar([vN = Summe( Home.Syntax_ALL::_k1 ) ;vTitles = Summe( Home.Syntax_ALL::_kIsGroupTitle ) ;vKeywords = Summe( Home.Syntax_ALL::_kIsWildcard ) ;vFunctions = Summe( Home.Syntax_ALL::_kIsFunction ) ;vFormula = Summe( Home.Syntax_ALL::_kIsFormula ) ;vVars = Summe( Home.Syntax_ALL::_kIsVariable ) ;vCalculations = vFunctions + vFormula + vVars ;vScriptSteps =  Summe( Home.Syntax_ALL::_kIsScriptStep ) - vTitles ;vCommands =  vScriptSteps - vKeywords;vSyntax = vN - vTitles ;vOn =  Summe( Home.Syntax_ALL::On ) ;vOff = vSyntax - vOn ; vGUISyntax = Summe( Home.Syntax_ALL.GUISyntax::_kDifferent )];Liste( Falls( vOff ; vOn & " / " )  & vSyntax & " fmSyntaxColorizer syntax definitions:";"  " & vScriptSteps & " script steps ( " & vCommands & " commands and " & vKeywords & " *keywords* )" ; "  " & vCalculations & " calculations ( " & vFormula & " symbols, " & vFunctions & " functions, " & vVars & " variables )" ; Falls( vGUISyntax ; "Plus " & vGUISyntax & " definitions in " & Home.Syntax_ALL::_gLanguage )))]]></Text>
