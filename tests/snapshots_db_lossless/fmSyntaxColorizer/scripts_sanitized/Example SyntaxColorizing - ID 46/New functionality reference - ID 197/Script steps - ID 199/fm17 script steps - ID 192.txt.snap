# # Perform Script by Name

# normal = "From list"
Script ausführen [ "Hello::World" ; Specified: Aus Liste ; Parameter: ]

# new = "By Name" in the format "File::ScriptName"
Script ausführen [ Specified: Nach Name ; "How much of a script name can be seen in various places if it is a really long script name up to 100" ; Parameter: 123 ]
Variable setzen [ $Name ; "How much of a script name can be seen in various places if it is a really long script name up to 100" ]
Script ausführen [ Specified: Nach Name ; $Name ; Parameter: 123 ]

# from file…
Script ausführen [ "A typical script" ; Specified: Aus Liste ; File: "Self" ; Parameter: 123 ]
Script ausführen [ "Hello::World" ; Specified: Aus Liste ; Parameter: 123 ]
Script ausführen [ "Hello::World" ; Specified: Aus Liste ; File: "Self" ; Parameter: 123 ]

Script ausführen [ Specified: Nach Name ; "Self::A typical script" ; Parameter: 123 ]
Script ausführen [ Specified: Nach Name ; "::Hello::World" ; Parameter: 123 ]
Script ausführen [ Specified: Nach Name ; "Self::Hello::World" ; Parameter: 123 ]



